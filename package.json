{
  "name": "learning-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test \"lib/**/*.test.ts\"",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma db push --force-reset && npm run db:seed",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/docker-up.ps1 && docker compose up -d --build",
    "deploy:logs": "docker compose logs -f app",
    "deploy:stop": "docker compose down",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.80",
    "@ai-sdk/react": "^4.0.160",
    "@prisma/client": "^6.19.3",
    "ai": "^7.0.156",
    "bcryptjs": "^3.0.3",
    "imapflow": "^2.9.1",
    "mailparser": "^3.12.4",
    "next": "16.4.2",
    "next-auth": "^5.0.0-beta.32",
    "next-mdx-remote": "^6.0.0",
    "nodemailer": "^8.0.11",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
