// Learning Portal — data model
// Courses live as MDX files in content/courses/<slug>/ (content-as-code).
// The DB stores only dynamic data: users, roles, access grants, progress, quiz results.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum UserStatus {
  INVITED // created by admin, invite sent, password not set yet
  ACTIVE // invite accepted, can log in
  DISABLED // access revoked
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String? // null until the invite is accepted
  role         Role       @default(USER)
  status       UserStatus @default(INVITED)
  createdAt    DateTime   @default(now())

  access      CourseAccess[]
  progress    Progress[]
  quizResults QuizResult[]
  invites     InviteToken[]
  agents      Agent[]
  receipts    Receipt[]
  chats       Chat[]
  auditLogs   AuditLog[]
  assistant   Assistant?
  connections McpConnection[]
  guardrailDocs GuardrailDoc[]
  models      LlmModel[]
}

// One-time invite / password-set link sent by email.
model InviteToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique // sha256 of the raw token (raw token only lives in the emailed link)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// Which user has access to which course (admin grants).
model CourseAccess {
  userId     String
  courseSlug String
  grantedAt  DateTime @default(now())
  grantedBy  String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, courseSlug])
}

// A completed page/lesson within a course.
model Progress {
  userId      String
  courseSlug  String
  pageSlug    String
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, courseSlug, pageSlug])
}

// A submitted quiz attempt (graded server-side).
model QuizResult {
  id          String   @id @default(cuid())
  userId      String
  courseSlug  String
  pageSlug    String
  quizId      String
  score       Int
  total       Int
  passed      Boolean
  answers     String // JSON string (SQLite has no native JSON)
  submittedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, courseSlug])
}

// ---------- Family agents ----------

enum AgentType {
  RECEIPTS // collects receipts from email into expense stats
  CUSTOM // «Свой агент»: instruction + tools + guardrails (lib/agents/custom.ts)
}

enum AgentRunStatus {
  RUNNING
  OK
  ERROR
}

// ---------- LLM models ----------

// An OpenAI-compatible LLM endpoint. Exactly one is the default (kept by code).
model LlmModel {
  id        String    @id @default(cuid())
  ownerId   String? // personal model; models made before this had none and go to the first admin (prisma/fix-data.ts)
  owner     User?     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  baseUrl   String // up to /v1
  model     String // model id sent to the endpoint
  tokenEnc  String? // AES-GCM encrypted API token (lib/secret.ts); never sent to the browser
  isDefault Boolean   @default(false)
  contextTokens Int   @default(32000) // how much the model keeps in mind; long chats get summarized at 70 % (lib/chat/context.ts)
  checkedAt DateTime?
  checkOk   Boolean?
  checkMsg  String    @default("")
  createdAt DateTime  @default(now())

  agents Agent[]
  chats  Chat[]
  assistants Assistant[]
}

// A configured automation owned by a family member.
model Agent {
  id        String    @id @default(cuid())
  ownerId   String
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  type      AgentType
  name      String
  enabled   Boolean   @default(true)
  config    String    @default("{}") // JSON: filters, lookback days, etc.
  agentIds  String    @default("[]") // JSON: other agents this agent may call (not used by the receipts agent yet)
  mcpIds    String    @default("[]") // JSON: MCP servers it may use
  mcpAccess String    @default("{}") // JSON {connectionId: "read" | "send"}: what it may do with each (lib/agents/policy.ts)
  apis      String    @default("[]") // JSON: portal APIs it may call
  instruction String  @default("") // system instruction («Свой агент»)
  hitl      String    @default("confirm") // JSON {enabled, ask}; old "confirm" / "none" still read (lib/agents/policy.ts)
  guardrails String   @default("{}") // JSON {enabled, rules}; the old {maskPii, maxSteps, forbiddenTopics} still read
  modelId   String? // null → the default model
  model     LlmModel? @relation(fields: [modelId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())

  runs AgentRun[]

  @@index([ownerId])
}

// One execution of an agent (manual "Run now" or scheduled later).
model AgentRun {
  id         String         @id @default(cuid())
  agentId    String
  agent      Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  status     AgentRunStatus @default(RUNNING)
  startedAt  DateTime       @default(now())
  finishedAt DateTime?
  processed  Int            @default(0) // items looked at
  created    Int            @default(0) // new records produced
  summary    String         @default("")
  log        String         @default("") // plain-text run log

  @@index([agentId, startedAt])
}

// A parsed receipt -> expense statistics.
model Receipt {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  merchant    String
  total       Float
  currency    String   @default("RUB")
  purchasedAt DateTime
  category    String   @default("прочее")
  items       String   @default("[]") // JSON [{name, qty, price}]
  sourceId    String?  @unique // email Message-ID / hash, for dedupe
  sourceAgent String? // agent id that produced it
  createdAt   DateTime @default(now())

  @@index([ownerId, purchasedAt])
}

// ─── Chat ─────────────────────────────────────────────────────────

model Chat {
  id        String    @id // generated in the browser (AI SDK generateId)
  ownerId   String
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title     String    @default("") // empty until the first answer
  modelId   String? // null → the default model
  model     LlmModel? @relation(fields: [modelId], references: [id], onDelete: SetNull)
  pinned    Boolean   @default(false)
  archived  Boolean   @default(false)
  messages  String    @default("[]") // JSON UIMessage[] (AI SDK)
  summary   String    @default("") // the model's retelling of the first summaryUpto messages (long chats)
  summaryUpto Int     @default(0)
  summaryLastId String @default("") // id of the last retold message: when it moves, the summary is stale
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([ownerId, updatedAt])
}

// ─── Journal (admin «Журнал») ─────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  at        DateTime @default(now())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName String // snapshot: user name, e-mail of a failed login, or «Система»
  event     String // key in lib/audit-events.ts
  channel   String   @default("портал") // портал | чат | система
  details   String   @default("")
  search    String   @default("") // lower-cased actor + event + details: SQLite LIKE ignores case only for ASCII

  @@index([at])
}

// ─── Base assistant (the chat's own agent), one per user ───────────

model Assistant {
  ownerId   String    @id
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  modelId   String? // null → the default model
  model     LlmModel? @relation(fields: [modelId], references: [id], onDelete: SetNull)
  agentIds  String    @default("[]") // JSON: agents it may run; nothing allowed until chosen
  mcpIds    String    @default("[]") // JSON: MCP servers it may use (none exist yet)
  mcpAccess String    @default("{}") // JSON {connectionId: "read" | "send"} (lib/agents/policy.ts)
  apis      String    @default("[]") // JSON: portal APIs it may call, keys of ASSISTANT_APIS
  instruction String  @default("") // added to the built-in chat instructions
  hitl      String    @default("\"changes_and_send\"") // JSON HITL choice (lib/agents/policy.ts)
  guardrails String   @default("{}") // JSON {rules}; {} → the default rules
  updatedAt DateTime  @updatedAt
}

// ─── Guardrail documents: rules a user uploads once (docx, pdf, txt, md) and gives to agents ───

model GuardrailDoc {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  description String   @default("")
  fileName    String
  mime        String
  size        Int
  data        Bytes // the uploaded file, as is
  text        String // its text, extracted on upload; this is what the model gets
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId])
}

// ─── MCP: the user's connections to outside services (catalog in lib/connectors.ts) ───

model McpConnection {
  id        String    @id @default(cuid())
  ownerId   String
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  kind      String // connector key, e.g. "mail"
  name      String
  config    String    @default("{}") // JSON settings without secrets (host, port, user…)
  secretEnc String? // password / token, AES-GCM (lib/secret.ts); never sent to the browser
  checkedAt DateTime?
  checkOk   Boolean?
  checkMsg  String    @default("")
  createdAt DateTime  @default(now())

  @@index([ownerId])
}
